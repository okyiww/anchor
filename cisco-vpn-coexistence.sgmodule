#!name=Cisco VPN 共存
#!desc=Cisco Secure Client 建连绕过 Surge：网关直连 + 公司域名走系统 Split DNS。公司 VPN 分流隧道场景专用。
#!system=mac

[General]
# 覆盖主配置的 skip-proxy / tun-excluded-routes（模块为整值覆盖，须保持完整列表）
skip-proxy = localhost, *.local, vpn-oa.eccom.com.cn, 210.5.150.101, injections.adguard.org, local.adguard.org, captive.apple.com, guzzoni.apple.com, 0.0.0.0/8, 10.0.0.0/8, 17.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 192.88.99.0/24, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4, 255.255.255.255/32
tun-excluded-routes = 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 192.88.99.0/24, 198.51.100.0/24, 203.0.113.0/24, 210.5.150.101/32, 224.0.0.0/4, 255.255.255.255/32
always-real-ip = vpn-oa.eccom.com.cn

[Host]
*.eccom.com.cn = server:syslib
